# ============================================================
# AI Interview Trainer — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it contains secrets.
# This file (.env.example) must NEVER contain real credentials.
# ============================================================

# ============================================================
# Deployment & Cross-Origin Configuration
# ============================================================
# Frontend URL for backend CORS configuration (e.g. your Vercel deployment)
FRONTEND_URL=https://ai-interview-trainer-eight.vercel.app

# Backend API URL for frontend client (used by Vite on Vercel)
VITE_API_URL=https://ai-interview-trainer-backend-5s3m.onrender.com

# ============================================================
# IBM watsonx Orchestrate — Core Configuration
# Source: IBM Cloud Console / watsonx Orchestrate workspace
# ============================================================

# Full instance API base URL
# Format: https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
IBM_ORCHESTRATE_BASE_URL=

# IBM Cloud IAM API Key (from IBM Cloud → Manage → Access → API keys)
IBM_ORCHESTRATE_API_KEY=

# Interview Trainer Agent ID (from watsonx Orchestrate → Agent settings)
IBM_ORCHESTRATE_AGENT_ID=e3823416-XXXX-XXXX-XXXX-XXXXXX0e39d1

# Agent version label
IBM_ORCHESTRATE_AGENT_VERSION=v2.0

# Deployment environment: live or draft
IBM_ORCHESTRATE_ENVIRONMENT=live

# Agent Environment ID (from the embedded chat script: agentEnvironmentId)
IBM_ORCHESTRATE_AGENT_ENV_ID=806c2d20-XXXX-XXXX-XXXX-XXXXXX0e39d1

# Orchestration ID (from embedded script: orchestrationID — non-secret, used for chat widget)
IBM_ORCHESTRATE_ORCHESTRATION_ID=

# Host URL for watsonx Orchestrate region (non-secret)
IBM_ORCHESTRATE_HOST_URL=https://jp-tok.watson-orchestrate.cloud.ibm.com

# ============================================================
# IBM Voice Services — Speech to Text (optional)
# Leave blank to disable voice features
# Source: IBM Cloud → Watson → Speech to Text → Service credentials
# ============================================================
IBM_STT_API_URL=
IBM_STT_API_KEY=

# ============================================================
# IBM Voice Services — Text to Speech (optional)
# Leave blank to disable voice features
# Source: IBM Cloud → Watson → Text to Speech → Service credentials
# ============================================================
IBM_TTS_API_URL=
IBM_TTS_API_KEY=

# ============================================================
# Application Configuration
# ============================================================
PORT=3001
NODE_ENV=development
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# ============================================================
# Development Mock Mode
# MUST be false for real IBM agent usage.
# Set to true ONLY when IBM credentials are not yet available (local dev).
# ============================================================
ENABLE_MOCK_AI=false